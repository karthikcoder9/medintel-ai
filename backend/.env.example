# ============================================================
# MedIntel AI — Backend Environment Configuration
# Copy this file to .env and fill in your actual values locally
# NEVER commit .env to version control
# ============================================================

# ----- Application -----
APP_NAME="MedIntel AI"
APP_VERSION="1.0.0"
APP_ENV="development"          # development | staging | production
DEBUG=true
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# ----- Server -----
HOST="0.0.0.0"
PORT=8000

# ----- MongoDB -----
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="medintel_db"

# ----- Redis -----
REDIS_URL="redis://localhost:6379"
REDIS_CACHE_TTL=3600           # Cache TTL in seconds (1 hour)

# ----- JWT -----
JWT_SECRET_KEY="CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_64_CHARS"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- Google Gemini -----
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_VISION_MODEL="gemini-1.5-flash"
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TEMPERATURE=0.3         # Lower = more factual, less creative

# ----- DeepSeek API -----
DEEPSEEK_API_KEY="your-deepseek-api-key-here"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# ----- External Drug APIs -----
OPENFDA_API_KEY="your-openfda-key-here"
OPENFDA_BASE_URL="https://api.fda.gov/drug"

# ----- Security -----
BCRYPT_ROUNDS=12
RATE_LIMIT_PER_MINUTE=100
MAX_IMAGE_UPLOAD_MB=10

# ----- Logging -----
LOG_LEVEL="INFO"               # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT="json"              # json | console
